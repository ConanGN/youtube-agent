# YouTube数据处理与AI增强平台 - 环境变量配置示例

# =============================================================================
# YouTube API配置
# =============================================================================
# YouTube Data API v3密钥 (必需)
# 获取地址: https://console.developers.google.com/
YOUTUBE_API_KEY=AIzaSyC9LP7mq3ZHANL8W1OIftPjUTg2ENM13Ak

# =============================================================================
# AI服务配置 (使用OpenRouter统一API)
# =============================================================================
# OpenRouter API密钥 (统一AI服务)
# 获取地址: https://openrouter.ai/keys
OPENROUTER_API_KEY=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

# 已弃用的AI服务密钥 (保留备用)
# OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# =============================================================================
# 应用配置
# =============================================================================
# 应用运行环境
NODE_ENV=development

# 应用域名 (生产环境需要配置)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =============================================================================
# 数据库配置 (可选，用于数据持久化)
# =============================================================================
# DATABASE_URL=postgresql://username:password@localhost:5432/youtube_agent

# =============================================================================
# 其他配置
# =============================================================================
# API请求超时时间 (毫秒)
API_TIMEOUT=30000

# 最大并发请求数
MAX_CONCURRENT_REQUESTS=5

# 日志级别
LOG_LEVEL=info

# =============================================================================
# 安全配置 (生产环境必需)
# =============================================================================
# JWT密钥 (生产环境必需)
# JWT_SECRET=your_jwt_secret_here

# 加密密钥 (生产环境必需)
# ENCRYPTION_KEY=your_encryption_key_here

# CORS允许的源 (生产环境配置)
# CORS_ORIGIN=https://yourdomain.com